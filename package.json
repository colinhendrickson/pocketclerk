{
  "name": "pocketclerk",
  "version": "0.1.0",
  "private": true,
  "description": "White-label point of sale and work-training app for student-run school carts, built for a special-education program.",
  "license": "MIT",
  "author": "Colin Hendrickson",
  "homepage": "https://github.com/colinhendrickson/pocketclerk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhendrickson/pocketclerk.git"
  },
  "bugs": {
    "url": "https://github.com/colinhendrickson/pocketclerk/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed.ts",
    "test:e2e": "tsx scripts/demo-db.ts && playwright test",
    "admin:add": "tsx src/db/add-admin.ts",
    "icons": "tsx scripts/render-icons.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.9",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-bluetooth": "^0.0.21",
    "daisyui": "^5.7.28",
    "dotenv": "^18.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@9.4.0",
  "pnpm": {
    "overrides": {
      "eslint-plugin-react-hooks": "^5.2.0"
    }
  }
}
