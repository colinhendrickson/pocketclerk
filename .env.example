# Copy to .env.local and fill in. Never commit .env.local.

# --- Database -------------------------------------------------------------
# If you use Vercel's Supabase integration, it provisions POSTGRES_URL and
# POSTGRES_URL_NON_POOLING instead, and the app reads those too. Set these two
# only when you are not using the integration.
#
# Local development against the Docker Postgres (pnpm db:up).
DATABASE_URL="postgresql://pocketclerk:pocketclerk@localhost:54329/pocketclerk"
# Migrations only. In production this is Supabase's DIRECT connection (port 5432);
# DATABASE_URL is the pooled one (port 6543). The pooler strips session features
# that drizzle-kit needs, which is why these are two separate variables.
#
# The app disables prepared statements automatically on a pooled connection,
# because Supabase's pooler gives each statement a different backend and a
# prepared statement made on one is not there for the next.
DIRECT_URL="postgresql://pocketclerk:pocketclerk@localhost:54329/pocketclerk"

# --- Student session cookie ----------------------------------------------
# Signs the httpOnly cookie holding the open shift id.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-32-random-bytes-in-hex"

# --- Email (optional in development) -------------------------------------
# Without RESEND_API_KEY the app logs receipts to the console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="receipts@example.com"
EMAIL_REPLY_TO="program-admin@example.com"

# --- Receipt queue -------------------------------------------------------
# Shared secret for the email consumer endpoint, which a scheduler calls every
# few minutes to sweep the queue. Leave empty in development and on the demo,
# where there is nothing to protect.
CRON_SECRET=""

# Base address used to build administrator sign-in links. Must match how the
# app is actually reached, or the link in the email points nowhere.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Device pairing -------------------------------------------------------
# Locks the student screens to iPads that have been set up once, by visiting
#   https://your-domain/setup?code=THIS-VALUE
# Without it the cart is open to anyone with the address, which means the list
# of pupils' first names is too. Leave empty for local development and the
# public demo; set a long random value on a real deployment.
DEVICE_CODE=""

# --- White-label branding -------------------------------------------------
# Fictional defaults ship in the repo. A real deployment overrides these in its
# own environment; no real program name belongs in git.
NEXT_PUBLIC_PROGRAM_NAME="Maple Grove Learning Program"
NEXT_PUBLIC_CART_NAME="Sunrise Snack Cart"
NEXT_PUBLIC_REWARD_NAME="Tickets"
NEXT_PUBLIC_THEME="pocketclerk"
NEXT_PUBLIC_DEMO_MODE="false"

# --- Time zone ------------------------------------------------------------
# The zone the cart operates in. Every time shown, every receipt, and every
# "today" filter uses it. Servers run on UTC, so without this an 8:15 order
# prints as 12:15. Any IANA name; an invalid one falls back to the default.
NEXT_PUBLIC_TIME_ZONE="America/New_York"
